/* ================================
   Valentín Zárate - Research Website
   Theme: Movement Ecology + Code
   ================================ */

/* ---------- Variables ---------- */
:root {
    --bg-main: #07110d;
    --bg-panel: #0e1b16;
    --bg-card: rgba(18, 35, 28, 0.92);
    --bg-card-soft: rgba(28, 52, 42, 0.85);

    --green-main: #7dd87d;
    --green-soft: #a8d5ba;
    --green-dark: #233d2f;
    --green-muted: #6f8f78;

    --code-cyan: #52f0c4;
    --code-purple: #b69cff;
    --code-yellow: #e6cf7a;

    --text-main: #eef7ef;
    --text-soft: #c7d8cc;
    --text-muted: #91a799;

    --border-soft: rgba(168, 213, 186, 0.22);
    --shadow-soft: 0 18px 50px rgba(0, 0, 0, 0.35);

    --sidebar-width: 230px;
}

/* ---------- Base ---------- */
* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    padding: 0;
    font-family: "Inter", "Open Sans", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    background:
        radial-gradient(circle at top left, rgba(82, 240, 196, 0.13), transparent 32%),
        radial-gradient(circle at bottom right, rgba(125, 216, 125, 0.12), transparent 30%),
        linear-gradient(135deg, #07110d 0%, #0a1511 45%, #08120e 100%);
    color: var(--text-main);
    overflow-x: hidden;
}

/* Grid / map texture background */
body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -2;
    background-image:
        linear-gradient(rgba(168, 213, 186, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(168, 213, 186, 0.04) 1px, transparent 1px);
    background-size: 44px 44px;
}

/* Subtle movement track lines */
body::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background:
        radial-gradient(circle at 20% 25%, rgba(125, 216, 125, 0.13) 0 2px, transparent 3px),
        radial-gradient(circle at 42% 38%, rgba(82, 240, 196, 0.11) 0 2px, transparent 3px),
        radial-gradient(circle at 68% 30%, rgba(182, 156, 255, 0.10) 0 2px, transparent 3px),
        radial-gradient(circle at 80% 70%, rgba(230, 207, 122, 0.10) 0 2px, transparent 3px);
}

p {
    font-size: 1rem;
    line-height: 1.75;
    font-weight: 400;
    color: var(--text-soft);
}

h1, h2, h3 {
    margin-top: 0;
    letter-spacing: -0.03em;
}

h1 {
    font-size: clamp(2rem, 4vw, 3.4rem);
    color: var(--text-main);
}

h2 {
    color: var(--green-main);
}

h3 {
    color: var(--text-main);
    line-height: 1.35;
}

a {
    color: inherit;
}

/* ---------- Scroll progress ---------- */
#scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 5px;
    width: 0;
    z-index: 9999;
    background: linear-gradient(90deg, var(--green-main), var(--code-cyan), var(--code-purple));
    box-shadow: 0 0 18px rgba(82, 240, 196, 0.65);
    transition: width 0.2s ease;
}

/* ---------- Sidebar ---------- */
.sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-width);
    height: 100vh;
    padding: 2.2rem 1.1rem;
    background:
        linear-gradient(180deg, rgba(9, 20, 15, 0.96), rgba(15, 32, 25, 0.94)),
        radial-gradient(circle at top, rgba(125, 216, 125, 0.12), transparent 40%);
    border-right: 1px solid var(--border-soft);
    box-shadow: 12px 0 35px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(16px);
}

.sidebar::before {
    content: "VZ / movement.ecology";
    display: block;
    margin-bottom: 2.4rem;
    padding: 0.75rem 0.8rem;
    border: 1px solid var(--border-soft);
    border-radius: 14px;
    font-family: "Courier New", monospace;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    color: var(--code-cyan);
    background: rgba(82, 240, 196, 0.06);
}

.sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
}

.sidebar ul li {
    margin-bottom: 0.55rem;
}

.sidebar ul li a {
    display: block;
    padding: 0.9rem 0.9rem;
    border-radius: 14px;
    text-decoration: none;
    color: var(--text-soft);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    border: 1px solid transparent;
    transition:
        background-color 0.25s ease,
        color 0.25s ease,
        border-color 0.25s ease,
        transform 0.25s ease;
}

.sidebar ul li a::before {
    content: ">";
    margin-right: 0.55rem;
    color: var(--green-main);
    font-family: "Courier New", monospace;
}

.sidebar ul li a:hover {
    color: #06110d;
    background: linear-gradient(135deg, var(--green-main), var(--code-cyan));
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateX(5px);
}

.sidebar.scrolled {
    background-color: rgba(9, 20, 15, 0.96);
    box-shadow: 12px 0 35px rgba(0, 0, 0, 0.4);
}

/* ---------- Main layout ---------- */
.main-content {
    margin-left: var(--sidebar-width);
    padding: 3rem clamp(1.2rem, 4vw, 4.5rem);
    max-width: 1320px;
}

/* ---------- Sections ---------- */
.section {
    position: relative;
    margin-bottom: 2.5rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: 28px;
    background:
        linear-gradient(145deg, rgba(18, 35, 28, 0.94), rgba(8, 19, 14, 0.9));
    border: 1px solid var(--border-soft);
    box-shadow: var(--shadow-soft);
    overflow: visible;
    transition:
        transform 0.35s ease,
        border-color 0.35s ease,
        box-shadow 0.35s ease;
}

.section::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
        linear-gradient(90deg, rgba(125, 216, 125, 0.16), transparent 38%),
        radial-gradient(circle at top right, rgba(82, 240, 196, 0.10), transparent 34%);
    opacity: 0.55;
}

.section:hover {
    transform: translateY(-4px);
    border-color: rgba(125, 216, 125, 0.45);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45);
}

.section > * {
    position: relative;
    z-index: 1;
}

.section h1:not(.static-title) {
    display: inline-block;
    margin-bottom: 1.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid rgba(82, 240, 196, 0.6);
}

.section h1:not(.static-title)::before {
    content: "# ";
    color: var(--code-cyan);
    font-family: "Courier New", monospace;
}

/* ---------- About ---------- */
.content-wrapper {
    display: grid;
    grid-template-columns: 330px minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
}

.image-content {
    position: relative;
}

.image-content::before {
    content: "";
    position: absolute;
    inset: -14px;
    border-radius: 30px;
    border: 1px solid rgba(82, 240, 196, 0.35);
    transform: rotate(-2deg);
}

.image-content::after {
    content: "tracking individual movement";
    position: absolute;
    left: 18px;
    bottom: 18px;
    padding: 0.4rem 0.65rem;
    border-radius: 999px;
    color: #06110d;
    background: linear-gradient(135deg, var(--green-main), var(--code-cyan));
    font-family: "Courier New", monospace;
    font-size: 0.72rem;
    font-weight: 700;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
}

.image-content img {
    width: 100%;
    height: 410px;
    object-fit: cover;
    border-radius: 26px;
    filter: saturate(0.92) contrast(1.05);
    box-shadow: 0 22px 55px rgba(0, 0, 0, 0.45);
}

.static-title {
    display: inline-block;
    margin-bottom: 1.1rem;
    padding: 0.65rem 0.9rem;
    border-radius: 14px;
    border: 1px solid rgba(82, 240, 196, 0.3);
    background: rgba(82, 240, 196, 0.08);
    color: var(--code-cyan);
    font-family: "Courier New", monospace;
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: none;
}

.static-title::before {
    content: "const researcher = ";
    color: var(--green-main);
}

.text-content p {
    max-width: 760px;
    font-size: 1.08rem;
}

/* ---------- Research Projects ---------- */
#research {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.project-wrapper {
    display: grid;
    grid-template-columns: 190px 1fr auto;
    align-items: center;
    gap: 1.4rem;
    padding: 1.3rem;
    border-radius: 24px;
    background:
        linear-gradient(145deg, rgba(27, 49, 39, 0.95), rgba(11, 24, 18, 0.94));
    border: 1px solid rgba(168, 213, 186, 0.18);
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.28);
    opacity: 1;
    transform: none;
    transition:
        transform 0.35s ease,
        border-color 0.35s ease,
        background-color 0.35s ease;
}

.project-wrapper:hover {
    transform: translateY(-6px);
    border-color: rgba(82, 240, 196, 0.48);
}

.project-wrapper.slide-in {
    opacity: 1;
    transform: none;
}

.project-image img,
.project-image2 img {
    width: 190px;
    height: 160px;
    object-fit: cover;
    border-radius: 18px;
    border: 1px solid rgba(168, 213, 186, 0.22);
    filter: saturate(0.95) contrast(1.04);
}

.project-image2 img {
    object-position: right center;
}

.project-photo img {
    width: 190px;
    height: 160px;
    object-fit: cover;
    border-radius: 18px;
    border: 1px solid rgba(168, 213, 186, 0.22);
    box-shadow: none;
    transition:
        transform 0.35s ease,
        filter 0.35s ease;
}

.project-photo img:hover {
    transform: scale(1.04);
    filter: brightness(1.08);
}

.project-text h2 {
    margin-bottom: 0.45rem;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
}

.project-text h2::before {
    content: "./";
    color: var(--code-cyan);
    font-family: "Courier New", monospace;
}

.project-text p {
    margin-bottom: 0;
    max-width: 680px;
}

/* ---------- Publications ---------- */
.pub-wrapper {
    display: grid;
    gap: 1.2rem;
}

.pub-card {
    position: relative;
    padding: 1.4rem 1.5rem;
    border-radius: 22px;
    background:
        linear-gradient(145deg, rgba(25, 46, 37, 0.95), rgba(12, 26, 20, 0.96));
    border: 1px solid rgba(168, 213, 186, 0.2);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.28);
    transition:
        transform 0.35s ease,
        border-color 0.35s ease,
        box-shadow 0.35s ease;
}

.pub-card::before {
    content: "paper";
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.32rem 0.55rem;
    border-radius: 999px;
    background: rgba(182, 156, 255, 0.12);
    color: var(--code-purple);
    border: 1px solid rgba(182, 156, 255, 0.28);
    font-family: "Courier New", monospace;
    font-size: 0.72rem;
}

.pub-card:hover {
    transform: translateY(-6px);
    border-color: rgba(182, 156, 255, 0.45);
    box-shadow: 0 22px 48px rgba(0, 0, 0, 0.36);
}

.pub-card h3 {
    max-width: 860px;
    margin-bottom: 0.7rem;
    padding-right: 4rem;
}

.pub-card p {
    margin: 0.4rem 0;
    color: var(--text-muted);
}

.tooltip-trigger {
    display: inline-block;
    margin-top: 0.45rem;
    color: var(--code-cyan);
    text-decoration: none;
    cursor: pointer;
    font-family: "Courier New", monospace;
    font-size: 0.95rem;
    border-bottom: 1px dashed rgba(82, 240, 196, 0.7);
    transition: color 0.25s ease;
}

.tooltip-trigger:hover {
    color: var(--green-main);
}

/* ---------- Tooltips ---------- */
.tooltip {
    position: absolute;
    top: calc(100% - 0.5rem);
    left: 1.5rem;
    display: none;
    width: min(680px, calc(100vw - 320px));
    padding: 1.1rem;
    border-radius: 18px;
    background: rgba(5, 13, 9, 0.97);
    border: 1px solid rgba(82, 240, 196, 0.28);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.52);
    color: var(--text-soft);
    z-index: 50;
    opacity: 0;
    transform: translateY(8px);
    transition:
        opacity 0.25s ease,
        transform 0.25s ease;
}

.tooltip strong {
    color: var(--green-main);
}

.tooltip-visible,
.tooltip-trigger:hover + .tooltip,
.tooltip:hover {
    display: block;
    opacity: 1;
    transform: translateY(0);
}

.tooltip img {
    width: 100%;
    max-width: 260px;
    height: auto;
    margin-top: 0.7rem;
    border-radius: 12px;
    border: 1px solid rgba(168, 213, 186, 0.22);
}

.small-tooltip {
    width: 320px;
    left: 0;
}

/* ---------- Code links ---------- */
.data-wrapper {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
}

.data-link {
    position: relative;
    min-height: 110px;
    padding: 1.2rem;
    border-radius: 20px;
    text-decoration: none;
    font-family: "Courier New", monospace;
    color: var(--code-cyan);
    background:
        linear-gradient(145deg, rgba(5, 13, 9, 0.96), rgba(17, 32, 25, 0.96));
    border: 1px solid rgba(82, 240, 196, 0.22);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.28);
    transition:
        transform 0.3s ease,
        border-color 0.3s ease,
        color 0.3s ease;
}

.data-link::before {
    content: "function ";
    color: var(--green-main);
}

.data-link::after {
    content: "()";
    color: var(--code-purple);
}

.data-link:hover {
    transform: translateY(-6px);
    color: var(--green-main);
    border-color: rgba(82, 240, 196, 0.55);
}

/* ---------- CV ---------- */
.cv-container {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
}

.cv-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 170px;
    padding: 0.9rem 1.2rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    color: #06110d;
    background: linear-gradient(135deg, var(--green-main), var(--code-cyan));
    border: 1px solid rgba(255, 255, 255, 0.25);
    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.cv-link:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(82, 240, 196, 0.23);
}

/* ---------- Contact ---------- */
#contact-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)) auto;
    gap: 0.85rem;
    align-items: stretch;
}

#contact-form input,
#contact-form textarea {
    width: 100%;
    padding: 0.95rem 1rem;
    border-radius: 16px;
    border: 1px solid rgba(168, 213, 186, 0.22);
    background: rgba(5, 13, 9, 0.78);
    color: var(--text-main);
    font-size: 0.98rem;
    outline: none;
    box-shadow: inset 0 0 0 1px transparent;
    transition:
        border-color 0.25s ease,
        box-shadow 0.25s ease,
        background-color 0.25s ease;
}

#contact-form textarea {
    grid-column: 1 / 3;
    min-height: 120px;
    resize: vertical;
}

#contact-form input::placeholder,
#contact-form textarea::placeholder {
    color: var(--text-muted);
}

#contact-form input:focus,
#contact-form textarea:focus {
    border-color: rgba(82, 240, 196, 0.7);
    box-shadow: 0 0 0 4px rgba(82, 240, 196, 0.11);
    background: rgba(5, 13, 9, 0.95);
}

#contact-form button {
    grid-column: 3 / 4;
    grid-row: 1 / 3;
    padding: 0 1.5rem;
    border: none;
    border-radius: 18px;
    cursor: pointer;
    font-weight: 800;
    color: #06110d;
    background: linear-gradient(135deg, var(--green-main), var(--code-cyan));
    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        filter 0.3s ease;
}

#contact-form button:hover {
    transform: translateY(-4px);
    filter: brightness(1.06);
    box-shadow: 0 15px 35px rgba(82, 240, 196, 0.25);
}

/* ---------- Typewriter ---------- */
#typewriter {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--code-cyan);
    white-space: nowrap;
    overflow: hidden;
    font-family: "Courier New", monospace;
    animation: blink 0.8s step-end infinite;
}

@keyframes blink {
    from, to {
        border-color: transparent;
    }
    50% {
        border-color: var(--code-cyan);
    }
}

/* ---------- Responsive ---------- */
@media (max-width: 1020px) {
    :root {
        --sidebar-width: 190px;
    }

    .content-wrapper {
        grid-template-columns: 260px minmax(0, 1fr);
    }

    .image-content img {
        height: 340px;
    }

    .project-wrapper {
        grid-template-columns: 160px 1fr;
    }

    .project-photo {
        grid-column: 1 / -1;
    }

    .project-photo img {
        width: 100%;
        height: 220px;
    }

    .data-wrapper {
        grid-template-columns: 1fr;
    }

    #contact-form {
        grid-template-columns: 1fr;
    }

    #contact-form textarea,
    #contact-form button {
        grid-column: auto;
        grid-row: auto;
    }

    #contact-form button {
        min-height: 54px;
    }
}

@media (max-width: 768px) {
    .sidebar {
        position: sticky;
        top: 0;
        width: 100%;
        height: auto;
        padding: 0.85rem;
        z-index: 1000;
        border-right: none;
        border-bottom: 1px solid var(--border-soft);
    }

    .sidebar::before {
        margin-bottom: 0.8rem;
        text-align: center;
    }

    .sidebar ul {
        display: flex;
        gap: 0.45rem;
        overflow-x: auto;
        padding-bottom: 0.2rem;
    }

    .sidebar ul li {
        margin: 0;
        flex: 0 0 auto;
    }

    .sidebar ul li a {
        padding: 0.65rem 0.8rem;
        font-size: 0.85rem;
    }

    .main-content {
        margin-left: 0;
        padding: 1.2rem;
    }

    .content-wrapper {
        grid-template-columns: 1fr;
    }

    .image-content img {
        height: 360px;
    }

    .project-wrapper {
        grid-template-columns: 1fr;
    }

    .project-image img,
    .project-image2 img,
    .project-photo img {
        width: 100%;
        height: 240px;
    }

    .tooltip {
        left: 1rem;
        width: calc(100vw - 3rem);
    }

    .pub-card h3 {
        padding-right: 0;
    }

    .pub-card::before {
        position: static;
        display: inline-block;
        margin-bottom: 0.8rem;
    }
}

@media (max-width: 480px) {
    .section {
        padding: 1.2rem;
        border-radius: 22px;
    }

    .image-content img {
        height: 300px;
    }

    h1 {
        font-size: 2rem;
    }

    .static-title {
        font-size: 0.82rem;
    }
}
